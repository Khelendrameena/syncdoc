# Copy to .env and fill in. Never commit .env.
# Database password (used by both the db and server services in Docker).
DB_PASSWORD=syncdoc

# Native setup only: where the server connects.
# (In Docker, docker-compose.yml sets this for the server service.)
DATABASE_URL=postgres://syncdoc:syncdoc@localhost:5432/syncdoc

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Native setup only: server port and the URL the client is served from
# (used to build share links).
PORT=4000
FRONTEND_URL=http://localhost:5173
